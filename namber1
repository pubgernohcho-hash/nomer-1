def new_stats():
    return {
        "fetched": 0,
        "new": 0,
        "answered": 0,
        "failed": [],
        "invalid": 0,
        "rate_limited": False,
        "error": None,
    }


def save_new_reviews(reviews, stats):
    """Сохраняет новые отзывы в базу со статусом pending."""
    for review in reviews:
        review_id = str(review.get("id", "")).strip()

        if not review_id:
            stats["invalid"] += 1
            continue

        if review_exists(review_id):
            continue

        try:
            rating = int(review.get("productValuation"))
        except (TypeError, ValueError):
            stats["invalid"] += 1
            continue

        if not 1 <= rating <= 5:
            stats["invalid"] += 1
            continue

        text = (review.get("text") or "").strip()
        details = review.get("productDetails") or {}
        product = details.get("productName") or "Товар"

        if add_review(review_id, rating, text, product, make_answer(rating, text)):
            stats["new"] += 1


async def answer_pending(stats):
    """Отвечает на все ожидающие отзывы автоматически."""
    for item in get_pending_reviews():
        review_id = item["id"]

        update_status(review_id, "sending")

        try:
            await asyncio.to_thread(send_wb_answer, review_id, item["draft"])

        except requests.exceptions.HTTPError as e:
            resp = e.response
            code = resp.status_code if resp is not None else None

            if code == 429:
                # Лимит WB: ответ не опубликован, повторим в следующем цикле.
                update_status(review_id, "pending")
                stats["rate_limited"] = True
                logger.warning("WB: лимит запросов (429), останавливаю отправку")
                return

            ATTEMPTS[review_id] = ATTEMPTS.get(review_id, 0) + 1
            logger.error(
                "Ошибка отправки ответа %s (код %s, попытка %s)",
                review_id, code, ATTEMPTS[review_id],
            )

            if ATTEMPTS[review_id] >= MAX_ATTEMPTS:
                update_status(review_id, "failed")
                body = resp.text[:150] if resp is not None else ""
                stats["failed"].append(f"{item['product']} (код {code}) {body}".strip())
            else:
                update_status(review_id, "pending")

        except Exception:
            # Сетевая ошибка: пробуем снова в следующем цикле.
            ATTEMPTS[review_id] = ATTEMPTS.get(review_id, 0) + 1
            logger.exception("Сбой при отправке ответа %s", review_id)

            if ATTEMPTS[review_id] >= MAX_ATTEMPTS:
                update_status(review_id, "failed")
                stats["failed"].append(f"{item['product']} (сетевая ошибка)")
            else:
                update_status(review_id, "pending")

        else:
            update_status(review_id, "answered")
            ATTEMPTS.pop(review_id, None)
            stats["answered"] += 1
            logger.info(
                "Ответил на отзыв %s (%s звёзд)", review_id, item["rating"]
            )

        await asyncio.sleep(SEND_DELAY)


async def run_cycle():
    """Один полный цикл: забрать новые отзывы и ответить на них."""
    stats = new_stats()

    async with CYCLE_LOCK:
        for _ in range(MAX_ROUNDS):
            try:
                reviews = await asyncio.to_thread(fetch_reviews)

            except requests.exceptions.HTTPError as e:
                code = e.response.status_code if e.response is not None else None
                if code == 429:
                    logger.warning("WB: слишком много запросов (429)")
                    stats["error"] = "429"
                else:
                    logger.exception("Ошибка получения отзывов Wildberries")
                    stats["error"] = f"HTTP {code}" if code else "HTTP"
                break

            except Exception as e:
                logger.exception("Ошибка получения отзывов Wildberries")
                stats["error"] = str(e)[:200]
                break

            stats["fetched"] += len(reviews)
            save_new_reviews(reviews, stats)
            await answer_pending(stats)

            # Если WB вернул меньше полной страницы, отзывов больше нет.
            if stats["rate_limited"] or len(reviews) < PAGE_SIZE:
                break

        else:
            pass

        # Допроверяем то, что осталось pending (например, после 429 раньше).
        if not stats["rate_limited"] and not stats["error"]:
            await answer_pending(stats)

    return stats


async def notify_admin(bot, text):
    try:
        await bot.send_message(chat_id=ADMIN_ID, text=text[:4000])
    except Exception:
        logger.exception("Не удалось отправить сообщение владельцу")


async def scheduled_check(context: ContextTypes.DEFAULT_TYPE):
    """Плановая проверка. Владельцу пишем только если был результат или проблема."""
    stats = await run_cycle()

    lines = []

    if stats["answered"]:
        lines.append(f"✅ Автоматически отвечено на отзывов: {stats['answered']}")

    if stats["failed"]:
        lines.append(f"⚠️ Не удалось ответить ({len(stats['failed'])}):")
        lines.extend(f"• {f}" for f in stats["failed"][:10])
        lines.append("Когда исправите причину, верните их командой /retry.")

    if stats["error"] and stats["error"] != "429":
        lines.append(
            f"❌ Ошибка запроса к Wildberries: {stats['error']}. "
            "Проверьте токен WB (категория «Вопросы и отзывы»)."
        )

    if lines:
        await notify_admin(context.bot, "\n".join(lines))


