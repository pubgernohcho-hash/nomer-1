async def manual_poll(application: Application):
    """Запасной цикл, если JobQueue недоступен."""

    class Ctx:
        def __init__(self, app):
            self.application = app
            self.bot = app.bot
            self.bot_data = app.bot_data
            self.job = None

    await asyncio.sleep(5)

    while True:
        try:
            await scheduled_check(Ctx(application))
        except Exception:
            logger.exception("Ошибка проверки отзывов")

        await asyncio.sleep(POLL_SECONDS)


async def post_init(application: Application):
    if application.job_queue:
        application.job_queue.run_repeating(
            scheduled_check,
            interval=POLL_SECONDS,
            first=5,
        )
    else:
        logger.warning("JobQueue недоступен, использую запасной цикл")
        application.create_task(manual_poll(application))


