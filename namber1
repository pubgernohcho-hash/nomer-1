def fetch_reviews():
    response = requests.get(
        WB_REVIEWS_URL,
        headers={"Authorization": WB_TOKEN},
        params={
            "isAnswered": "false",
            "take": PAGE_SIZE,
            "skip": 0,
        },
        timeout=30,
    )

    response.raise_for_status()
    data = response.json()

    if data.get("error"):
        raise RuntimeError(data.get("errorText", "Ошибка Wildberries API"))

    return data.get("data", {}).get("feedbacks", [])


def send_wb_answer(review_id, text):
    response = requests.post(
        WB_ANSWER_URL,
        headers={
            "Authorization": WB_TOKEN,
            "Content-Type": "application/json",
        },
        json={
            "id": review_id,
            "text": text,
        },
        timeout=30,
    )

    response.raise_for_status()


