# Статусы: pending (ждёт отправки), sending, answered, failed

def db_connect():
    return sqlite3.connect(DB_PATH, timeout=30)


def init_db():
    with db_connect() as db:
        db.execute("""
            CREATE TABLE IF NOT EXISTS reviews (
                review_id TEXT PRIMARY KEY,
                status TEXT NOT NULL,
                rating INTEGER,
                review_text TEXT,
                product TEXT,
                draft TEXT
            )
        """)
        # Если бот был остановлен посреди отправки, пробуем ещё раз.
        # Если ответ уже был принят WB, повторная отправка будет отклонена.
        db.execute(
            "UPDATE reviews SET status = 'pending' "
            "WHERE status IN ('sending', 'check_needed', 'skipped')"
        )


def review_exists(review_id):
    with db_connect() as db:
        row = db.execute(
            "SELECT 1 FROM reviews WHERE review_id = ?", (review_id,)
        ).fetchone()
    return row is not None


def add_review(review_id, rating, text, product, draft):
    with db_connect() as db:
        cursor = db.execute(
            """
            INSERT OR IGNORE INTO reviews
            (review_id, status, rating, review_text, product, draft)
            VALUES (?, 'pending', ?, ?, ?, ?)
            """,
            (review_id, rating, text, product, draft),
        )
        return cursor.rowcount == 1


def update_status(review_id, status):
    with db_connect() as db:
        db.execute(
            "UPDATE reviews SET status = ? WHERE review_id = ?",
            (status, review_id),
        )


def get_pending_reviews():
    with db_connect() as db:
        rows = db.execute(
            """
            SELECT review_id, rating, review_text, product, draft
            FROM reviews
            WHERE status = 'pending'
            """
        ).fetchall()

    return [
        {
            "id": row[0],
            "rating": row[1],
            "text": row[2] or "",
            "product": row[3] or "Товар",
            "draft": row[4] or make_answer(row[1], row[2] or ""),
        }
        for row in rows
    ]


def count_by_status():
    with db_connect() as db:
        rows = db.execute(
            "SELECT status, COUNT(*) FROM reviews GROUP BY status"
        ).fetchall()
    return {status: count for status, count in rows}


def reset_failed():
    with db_connect() as db:
        cursor = db.execute(
            "UPDATE reviews SET status = 'pending' WHERE status = 'failed'"
        )
        return cursor.rowcount


