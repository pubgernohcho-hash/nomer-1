def main():
    if not TG_TOKEN or not WB_TOKEN or ADMIN_ID == 123456789:
        raise RuntimeError(
            "Заполни TG_TOKEN, WB_TOKEN и ADMIN_ID "
            "(в переменных окружения или в начале файла)"
        )

    init_db()

    app = (
        Application.builder()
        .token(TG_TOKEN)
        .post_init(post_init)
        .build()
    )

    app.add_handler(CommandHandler("start", start))
    app.add_handler(CommandHandler("check", check_command))
    app.add_handler(CommandHandler("status", status_command))
    app.add_handler(CommandHandler("retry", retry_command))

    logger.info("Запускаем Telegram-бота (автоответы включены)...")
    app.run_polling()


if __name__ == "__main__":
    main()
