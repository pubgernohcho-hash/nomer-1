def is_admin(update):
    return (
        update.effective_user is not None
        and update.effective_user.id == ADMIN_ID
    )


async def start(update: Update, context: ContextTypes.DEFAULT_TYPE):
    if not is_admin(update):
        await update.effective_message.reply_text("Доступ запрещён.")
        return

    await update.effective_message.reply_text(
        "🤖 Бот отзывов Wildberries работает в автоматическом режиме.\n"
        f"Он сам проверяет отзывы каждые {POLL_SECONDS // 60} мин "
        "и отвечает на них без вашего участия.\n\n"
        "/check — проверить и ответить прямо сейчас.\n"
        "/status — статистика по отзывам.\n"
        "/retry — повторить отзывы, на которые не удалось ответить."
    )


async def check_command(update: Update, context: ContextTypes.DEFAULT_TYPE):
    if not is_admin(update):
        await update.effective_message.reply_text("Доступ запрещён.")
        return

    await update.effective_message.reply_text("Проверяю отзывы и отвечаю...")

    stats = await run_cycle()

    if stats["error"] == "429":
        await update.effective_message.reply_text(
            "⏳ Wildberries ограничил запросы (429). "
            "Подождите 10–15 минут и попробуйте ещё раз."
        )
        return

    if stats["error"]:
        await update.effective_message.reply_text(
            f"❌ Ошибка при запросе к Wildberries: {stats['error']}\n"
            "Проверьте токен WB (категория «Вопросы и отзывы»)."
        )
        return

    lines = [
        f"Получено неотвеченных отзывов: {stats['fetched']}",
        f"Новых: {stats['new']}",
        f"Отвечено: {stats['answered']}",
    ]

    if stats["rate_limited"]:
        lines.append("⏳ Достигнут лимит WB (429), остальные ответы уйдут в следующей проверке.")

    if stats["failed"]:
        lines.append(f"⚠️ Не удалось ответить: {len(stats['failed'])}")
        lines.extend(f"• {f}" for f in stats["failed"][:10])

    if stats["invalid"]:
        lines.append(f"Не удалось разобрать: {stats['invalid']}")

    await update.effective_message.reply_text("\n".join(lines))


async def status_command(update: Update, context: ContextTypes.DEFAULT_TYPE):
    if not is_admin(update):
        await update.effective_message.reply_text("Доступ запрещён.")
        return

    counts = count_by_status()
    names = {
        "answered": "Отвечено",
        "pending": "Ждут отправки",
        "sending": "Отправляются",
        "failed": "Не удалось ответить",
    }

    if not counts:
        await update.effective_message.reply_text("В базе пока нет отзывов.")
        return

    lines = ["📊 Статистика:"]
    for status, count in counts.items():
        lines.append(f"• {names.get(status, status)}: {count}")

    await update.effective_message.reply_text("\n".join(lines))


async def retry_command(update: Update, context: ContextTypes.DEFAULT_TYPE):
    if not is_admin(update):
        await update.effective_message.reply_text("Доступ запрещён.")
        return

    count = reset_failed()
    ATTEMPTS.clear()

    await update.effective_message.reply_text(
        f"Вернул в очередь отзывов: {count}. Пробую ответить..."
    )

    await check_command(update, context)


